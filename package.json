    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
